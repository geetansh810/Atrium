# OS
.DS_Store

# Node (web/, office-realtime/)
node_modules/
dist/
dist-ssr/
*.local
*.log

# Java / Maven (core-api/)
target/
*.class

# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# Editor / local tool state
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json

# Terraform (infra/terraform/) — provider binaries + local plan/state; the
# real state lives in the S3 backend (10 §3), never committed here.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
