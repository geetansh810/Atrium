# Atrium — environment variables
# Copy to .env and fill in. Real .env is gitignored; never commit secrets.
# Each var notes the milestone that starts using it (atrium-docs/17).

# ── Infrastructure (M0.1) ────────────────────────────────────────────
# Postgres (pgvector/pgvector:pg16 via docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/atrium
DATABASE_USER=atrium
DATABASE_PASSWORD=atrium
# Redis 7 — outbox relay + office presence pub/sub
REDIS_URL=redis://localhost:6379

# ── Row Level Security runtime role (M3.2) ───────────────────────────
# The app's own connection (not Flyway/migrations, which keep DATABASE_USER
# above) — a least-privilege role V10__tenant_rls.sql creates, since Postgres
# RLS never applies to DATABASE_USER (it's the cluster's bootstrap role, and
# Postgres refuses to ever strip SUPERUSER from it). This dev default MUST be
# overridden to a real secret in any shared/staging/prod environment.
ATRIUM_APP_DB_USER=atrium_app
ATRIUM_APP_DB_PASSWORD=atrium_app

# ── LLM providers (M0.5a) ────────────────────────────────────────────
# Providers plug in behind the SPI (13 §1). Two are live: Anthropic (AnthropicClient)
# and Google Gemini (GoogleClient). A blank key = that provider is "not configured"
# and its agents park at the pre-dispatch gate — that's the correct off state.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini has a genuinely free tier (get a key at https://aistudio.google.com — no
# card needed). The seeded 'GeminiCoder' agent (gemini-3.1-flash-lite) runs the full
# claim→work→approve loop at $0. docker-compose forwards this into the core-api
# container; Compose auto-loads a root .env file (NOT .env.local).
GOOGLE_API_KEY=
# Per-call LLM timeout (13 §1)
ATRIUM_LLM_TIMEOUT=120s

# ── Embeddings / memory (M-MEM1) ─────────────────────────────────────
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
ATRIUM_MEMORY_TTL_DAYS=90

# ── Learning pipeline (M-LN1) ────────────────────────────────────────
ATRIUM_LEARNING_MODEL_TIER=fast

# ── App (M0.1+) ──────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
# Single rename point for the product name
PRODUCT_NAME=Atrium

# ── Auth (M3.1) ──────────────────────────────────────────────────────
# HS256 signing key for the session JWT (claims: userId, companyId, role).
# application.yml ships an insecure dev-only fallback — this MUST be set to a
# real random ≥32-byte secret in any shared/staging/prod environment.
ATRIUM_JWT_SECRET=

# ── Web dashboard (M0.8) ─────────────────────────────────────────────
# 1 = dashboard reads web/src/shared/mocks/*.json (session 2 mock layer, no
# backend needed); 0/unset (the default) = dashboard reads core-api over React
# Query (shared/api.ts), gated behind real signup/login (M3.1) — no company id
# env var needed anymore, `npm run seed:dev` just prints login credentials.
VITE_USE_MOCKS=0
VITE_API_BASE_URL=http://localhost:8080/api/v1
