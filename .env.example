# Atrium — environment variables
# Copy to .env and fill in. Real .env is gitignored; never commit secrets.
# Each var notes the milestone that starts using it (atrium-docs/17).

# ── Infrastructure (M0.1) ────────────────────────────────────────────
# Postgres (pgvector/pgvector:pg16 via docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/atrium
DATABASE_USER=atrium
DATABASE_PASSWORD=atrium
# Redis 7 — outbox relay + office presence pub/sub
REDIS_URL=redis://localhost:6379

# ── LLM providers (M0.5a) ────────────────────────────────────────────
# Anthropic is the first provider; others land via the provider SPI (13 §1).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Per-call LLM timeout (13 §1)
ATRIUM_LLM_TIMEOUT=120s

# ── Embeddings / memory (M-MEM1) ─────────────────────────────────────
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
ATRIUM_MEMORY_TTL_DAYS=90

# ── Learning pipeline (M-LN1) ────────────────────────────────────────
ATRIUM_LEARNING_MODEL_TIER=fast

# ── App (M0.1+) ──────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
# Single rename point for the product name
PRODUCT_NAME=Atrium
# Colyseus join-token signing secret (M2.x office-realtime)
OFFICE_ROOM_TOKEN_SECRET=change-me
